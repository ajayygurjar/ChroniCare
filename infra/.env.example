# Optional overrides for infra/docker-compose.yml. Copy to infra/.env (git-ignored).
# Every value below is also the built-in default, and is for LOCAL DEVELOPMENT ONLY.
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
CORE_DB_PASSWORD=core_dev_only
PAYMENTS_DB_PASSWORD=payments_dev_only
