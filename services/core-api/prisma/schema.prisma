// core_db: data owned by core-api (architecture plan, section 9).
// Conventions: UUID primary keys generated by the database, snake_case tables and columns,
// timestamps are timestamptz. Two things Prisma cannot express live in the migration SQL:
// the citext extension and the partial unique index that prevents double booking.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  patient
  doctor
  admin

  @@map("role")
}

enum AppointmentStatus {
  pending_payment
  pending
  confirmed
  completed
  cancelled

  @@map("appointment_status")
}

enum PrescriptionSource {
  doctor
  upload

  @@map("prescription_source")
}

enum UploadStatus {
  queued
  processing
  needs_review
  confirmed
  failed

  @@map("upload_status")
}

enum MealRelation {
  before
  after
  with
  any

  @@map("meal_relation")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patientProfile        PatientProfile?
  doctorProfile         DoctorProfile?
  appointmentsAsPatient Appointment[]        @relation("AppointmentPatient")
  appointmentsAsDoctor  Appointment[]        @relation("AppointmentDoctor")
  historyAsPatient      MedicalHistory[]     @relation("HistoryPatient")
  historyCreated        MedicalHistory[]     @relation("HistoryCreatedBy")
  prescriptionsReceived Prescription[]       @relation("PrescriptionPatient")
  prescriptionsIssued   Prescription[]       @relation("PrescriptionDoctor")
  prescriptionUploads   PrescriptionUpload[]

  @@map("users")
}

model PatientProfile {
  userId      String    @id @map("user_id") @db.Uuid
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  phone       String?
  gender      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model DoctorProfile {
  userId               String @id @map("user_id") @db.Uuid
  firstName            String @map("first_name")
  lastName             String @map("last_name")
  specialization       String
  experienceYears      Int    @default(0) @map("experience_years")
  // Integer minor units (paise/cents), never a float.
  consultationFeeMinor Int    @default(0) @map("consultation_fee_minor")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctor_profiles")
}

model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  doctorId    String            @map("doctor_id") @db.Uuid
  scheduledAt DateTime          @map("scheduled_at") @db.Timestamptz(6)
  reason      String?
  status      AppointmentStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient User @relation("AppointmentPatient", fields: [patientId], references: [id], onDelete: Restrict)
  doctor  User @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Restrict)

  // "No double booking" is a partial unique index on (doctor_id, scheduled_at) for
  // pending/confirmed rows. It is created in the init migration (Prisma has no syntax for it).
  @@index([patientId, scheduledAt])
  @@map("appointments")
}

model MedicalHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  diagnosis  String
  notes      String?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid

  patient User @relation("HistoryPatient", fields: [patientId], references: [id], onDelete: Restrict)
  author  User @relation("HistoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([patientId, recordedAt])
  @@map("medical_history")
}

model Prescription {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String             @map("patient_id") @db.Uuid
  doctorId  String?            @map("doctor_id") @db.Uuid
  source    PrescriptionSource
  uploadId  String?            @map("upload_id") @db.Uuid
  issuedAt  DateTime?          @map("issued_at") @db.Date
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  patient User                @relation("PrescriptionPatient", fields: [patientId], references: [id], onDelete: Restrict)
  doctor  User?               @relation("PrescriptionDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  upload  PrescriptionUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  items   PrescriptionItem[]

  @@index([patientId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionId String       @map("prescription_id") @db.Uuid
  drugName       String       @map("drug_name")
  strength       String?
  dose           String?
  frequency      String?
  timing         String?
  mealRelation   MealRelation @default(any) @map("meal_relation")
  durationDays   Int?         @map("duration_days")
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model PrescriptionUpload {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId     String       @map("patient_id") @db.Uuid
  objectKey     String       @map("object_key")
  mimeType      String       @map("mime_type")
  sizeBytes     Int          @map("size_bytes")
  status        UploadStatus @default(queued)
  rawText       String?      @map("raw_text")
  extracted     Json?        @db.JsonB
  confidence    Decimal?     @db.Decimal(4, 3)
  engine        String?
  engineVersion String?      @map("engine_version")
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient       User           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriptions Prescription[]

  @@index([patientId, status])
  @@map("prescription_uploads")
}
