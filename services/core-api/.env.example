# Copy to .env (git-ignored). These values match the defaults in infra/docker-compose.yml
# and are for LOCAL DEVELOPMENT ONLY. (NODE_ENV defaults to "development" when unset.)
PORT=4000
LOG_LEVEL=info

# Development database (core_db, owner core_api).
DATABASE_URL=postgresql://core_api:core_dev_only@localhost:5433/core_db

# Used by `npm test` instead of DATABASE_URL, so tests never touch development data.
# In CI there is no TEST_DATABASE_URL and DATABASE_URL points at a throwaway database.
TEST_DATABASE_URL=postgresql://core_api:core_dev_only@localhost:5433/core_db_test

# --- Authentication (all optional in development) ---
# RSA private key (PEM) that signs access tokens. Leave unset in development: a throwaway key is
# generated at startup and sessions refresh themselves after a restart. REQUIRED in production.
# Generate one with: npm run keys:generate
# JWT_PRIVATE_KEY=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# Send the refresh cookie over HTTPS only. Defaults to true in production, false otherwise.
# COOKIE_SECURE=false
# Login/signup attempts per IP per 15 minutes.
# AUTH_RATE_LIMIT_MAX=20
# Number of reverse proxies in front of the API (set 1 behind the gateway).
# TRUST_PROXY=0
