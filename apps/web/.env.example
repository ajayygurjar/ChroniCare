# Copy to .env (git-ignored) only if you need to change something. The defaults work for local
# development: start services/core-api on port 4000 and `npm run dev` forwards /api to it.

# Where `npm run dev` / `npm run preview` forward /api (the core-api address).
# API_PROXY_TARGET=http://localhost:4000

# Base URL the browser uses for API calls. Leave unset to use /api on the same origin (recommended:
# no CORS, and the login cookie stays a same-site cookie).
# VITE_API_BASE_URL=/api
